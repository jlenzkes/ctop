root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Windows PowerShell 5.1 reads a .ps1 without a BOM as ANSI (see tests/Encoding.Tests.ps1)
[*.{ps1,psd1}]
charset = utf-8-bom

[*.md]
trim_trailing_whitespace = false
